{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "jsPlugins": ["./tools/lint/plugin.mjs"],
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "town/no-cast-escape": "error"
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "deploy/**", "output/**"]
}
